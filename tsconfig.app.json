{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* אריזה: Vite אורז את הקוד, ו-TypeScript רק בודק טיפוסים (noEmit) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* בדיקות נוספות: שגיאה על משתנה או פרמטר שלא בשימוש, על תחביר TypeScript שאי אפשר פשוט למחוק (כמו enum),
       ועל case ב-switch שממשיך ל-case הבא בלי break */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
